# Funding Director — safe configuration template
#
# setup.sh creates agent.env for you. If an automation agent is doing the setup,
# it should ask for one value at a time and never display secret values afterward.
# A filled agent.env is private and ignored by git.

# Identity and server
AGENT_NAME=funding-director
BASE_DIR=/srv/funding-director
HERMES_PORT=18789
TZ=America/New_York
AGENT_PERSONA=concise
TELEGRAM_HOME_CHANNEL=
SLACK_HOME_CHANNEL=

# Model — OpenRouter is the only required account for the recommended path.
# Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
HERMES_MODEL=openai/gpt-5.6-luna

# Optional model fallbacks. The operator works without these.
FIREWORKS_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=

# Connect at least one channel.
# Telegram: create a bot with https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
# Slack: create an app with Socket Mode; provide both tokens.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Required for Slack. Copy the authorized owner's Member ID from Slack.
# Add more than one as comma-separated IDs, for example U01ABC123,U02DEF456.
SLACK_ALLOWED_USERS=
# Optional channels added after the first healthy reply.
DISCORD_BOT_TOKEN=
BLUEBUBBLES_SERVER_URL=
BLUEBUBBLES_PASSWORD=
# WhatsApp is configured after launch by the QR flow in finish-setup.sh.
GATEWAY_ALLOW_ALL_USERS=false

# Calendar, Gmail, Drive, Docs, Sheets, Notion, CRM and other business apps.
# Create a consumer key at https://app.composio.dev and connect only the apps
# you want the operator to use. Calendar uses the Google Calendar connection.
COMPOSIO_API_KEY=

# Funding systems. Create a dedicated Funding Machine key per assistant and a
# location-scoped GoHighLevel Private Integration Token. Never use a full-login
# Firebase refresh token.
FUNDING_MACHINE_API_KEY=
GHL_API_KEY=
GHL_LOCATION_ID=

# Browser research provider keys. Playwright works locally without these;
# extra providers add hosted sessions, scale, or persistent profiles.
BROWSER_USE_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_CONTEXT_ID=
HYPERBROWSER_API_KEY=
AIRTOP_API_KEY=
STEEL_API_KEY=
ORGO_API_KEY=
ORGO_COMPUTER_ID=
BROWSERLESS_TOKEN=
BROWSERLESS_BASE_URL=
DECODO_PROXY=
RTRVR_API_KEY=
GEMINI_API_KEY=
APIFY_API_KEY=

# Sales and marketing integrations used by the live operator. All optional.
INSTANTLY_API_KEY=
SMARTLEAD_API_KEY=
CALCOM_API_KEY=
RETELL_API_KEY=
CONVERTKIT_API_KEY=
JANGOMAIL_USERNAME=
JANGOMAIL_PASSWORD=
REACHER_CONSUMER_KEY=

# Optional Obsidian + Notion memory mirror.
# The core operator always persists locally even when these are blank.
NOTION_TOKEN=
NOTION_PARENT_PAGE=
NOTION_DB_SESSIONS=
NOTION_DB_KANBAN_TASKS=
NOTION_DB_MEMORIES=
NOTION_DB_SKILLS=
NOTION_DB_EVENTS=
SYNC_INTERVAL_SECONDS=60

# Scheduled briefings and follow-up jobs. Optional.
BRIEF_SLACK_CHANNEL=
TELEGRAM_CHAT_ID=
JOBS_MODEL=deepseek/deepseek-v4-flash
JOBS_FALLBACK_MODEL=z-ai/glm-4.6
CREDIT_ALERT_THRESHOLD=10

# Optional browser/phone voice front end through ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
VOICE_DOMAIN=
RELAY_TOKEN=

# Resource limits
HERMES_MEM_LIMIT=5g
HERMES_CPUS=3.0
